<section
  class="solo-video solo-video--{{ section.settings.color_scheme }}{% if section.settings.full_width %} solo-video--full-width{% endif %}"
  id="solo-video-{{ section.id }}"
  style="--sv-max-width: {% if section.settings.full_width %}100%{% else %}{{ section.settings.max_width }}px{% endif %}; --sv-padding: {{ section.settings.section_padding }}px;"
>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="solo-video__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="solo-video__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="solo-video__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="solo-video__wrap">
    {%- if section.settings.video != blank -%}
      <div class="solo-video__player solo-video__player--hosted">
        {{- section.settings.video | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          class: 'solo-video__hosted-video'
        -}}
        <button class="solo-video__btn solo-video__btn--playpause" type="button" aria-pressed="true" aria-label="Pause video">
          <span class="sv-icon-playing">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true" focusable="false">
              <rect x="6" y="4" width="4" height="16" rx="1"/>
              <rect x="14" y="4" width="4" height="16" rx="1"/>
            </svg>
          </span>
          <span class="sv-icon-paused">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true" focusable="false">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
          </span>
        </button>
        <button class="solo-video__btn solo-video__btn--sound" type="button" aria-pressed="false" aria-label="Unmute video">
          <span class="sv-icon-muted">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true" focusable="false">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
              <line x1="23" y1="9" x2="17" y2="15"/>
              <line x1="17" y1="9" x2="23" y2="15"/>
            </svg>
          </span>
          <span class="sv-icon-sound">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true" focusable="false">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
            </svg>
          </span>
        </button>
        <button class="solo-video__btn solo-video__btn--fullscreen" type="button" aria-pressed="false" aria-label="Enter fullscreen">
          <span class="sv-icon-expand">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M8 3H5a2 2 0 0 0-2 2v3"/>
              <path d="M21 8V5a2 2 0 0 0-2-2h-3"/>
              <path d="M3 16v3a2 2 0 0 0 2 2h3"/>
              <path d="M16 21h3a2 2 0 0 0 2-2v-3"/>
            </svg>
          </span>
          <span class="sv-icon-compress">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M8 3v3a2 2 0 0 1-2 2H3"/>
              <path d="M21 8h-3a2 2 0 0 1-2-2V3"/>
              <path d="M3 16h3a2 2 0 0 1 2 2v3"/>
              <path d="M16 21v-3a2 2 0 0 1 2-2h3"/>
            </svg>
          </span>
        </button>
      </div>

    {%- elsif section.settings.video_url != blank -%}
      <div
        class="solo-video__player solo-video__player--external"
        data-video-url="{{ section.settings.video_url.id }}"
        data-video-provider="{{ section.settings.video_url.type }}"
      >
        <div class="solo-video__thumbnail-wrap">
          {%- if section.settings.thumbnail != blank -%}
            {{ section.settings.thumbnail | image_url: width: 1400 | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1400',
              sizes: '100vw',
              class: 'solo-video__thumb-img',
              alt: section.settings.heading | escape
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'solo-video__thumb-placeholder' }}
          {%- endif -%}
        </div>
        <div class="solo-video__iframe-wrap" hidden></div>
      </div>

    {%- else -%}
      <div class="solo-video__placeholder">
        {{ 'collection-2' | placeholder_svg_tag: 'solo-video__placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.solo-video {
  padding: var(--sv-padding, 64px) 20px;
}

.solo-video--light {
  background: #ffffff;
  color: #111111;
}

.solo-video--dark {
  background: #0f0f0f;
  color: #f5f5f5;
}

.solo-video__header {
  max-width: var(--sv-max-width, 1200px);
  margin: 0 auto 32px;
  text-align: center;
}

.solo-video__heading {
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  font-weight: 700;
  line-height: 1.15;
  margin: 0 0 12px;
}

.solo-video__subheading {
  font-size: 1.125rem;
  opacity: 0.65;
  margin: 0 auto;
  max-width: 560px;
  line-height: 1.6;
}

.solo-video__wrap {
  max-width: var(--sv-max-width, 1200px);
  margin: 0 auto;
  border-radius: 14px;
  overflow: hidden;
  background: #111;
}

.solo-video--full-width .solo-video__wrap {
  border-radius: 0;
}

.solo-video--full-width {
  padding-left: 0;
  padding-right: 0;
}

.solo-video__player {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  max-height: 600px;
}

.solo-video__player--hosted {
  background: #000;
}

.solo-video__hosted-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.solo-video__player--external {
  background: #000;
}

.solo-video__thumbnail-wrap {
  position: absolute;
  inset: 0;
}

.solo-video__thumb-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.solo-video__thumb-placeholder {
  width: 100%;
  height: 100%;
  opacity: 0.3;
}

.solo-video__iframe-wrap {
  position: absolute;
  inset: 0;
}

.solo-video__iframe-wrap iframe {
  width: 100%;
  height: 100%;
  border: none;
  display: block;
}

.solo-video__iframe-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  background: transparent;
}

.solo-video__placeholder {
  aspect-ratio: 16 / 9;
  background: #e0e0e0;
}

.solo-video__placeholder-svg {
  width: 100%;
  height: 100%;
  opacity: 0.4;
}

.solo-video__btn {
  position: absolute;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.55);
  border: none;
  border-radius: 50%;
  color: #fff;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.3s ease, background 0.2s ease, transform 0.2s ease;
  z-index: 4;
  padding: 0;
}

.solo-video__player:hover .solo-video__btn {
  opacity: 1;
}

.solo-video__btn:hover {
  background: rgba(0,0,0,0.82);
  transform: scale(1.08);
}

.solo-video__btn:focus-visible {
  outline: 2px solid rgba(255,255,255,0.8);
  outline-offset: 2px;
}

.solo-video__btn--playpause {
  top: 14px;
  left: 14px;
}

.solo-video__btn--sound {
  top: 14px;
  right: 14px;
}

.solo-video__btn--fullscreen {
  bottom: 14px;
  right: 14px;
}

.solo-video__btn--playpause[aria-pressed="true"] .sv-icon-paused { display: none; }
.solo-video__btn--playpause[aria-pressed="false"] .sv-icon-playing { display: none; }

.solo-video__btn--sound[aria-pressed="false"] .sv-icon-sound { display: none; }
.solo-video__btn--sound[aria-pressed="true"] .sv-icon-muted { display: none; }

.solo-video__btn--fullscreen[aria-pressed="false"] .sv-icon-compress { display: none; }
.solo-video__btn--fullscreen[aria-pressed="true"] .sv-icon-expand { display: none; }

@media (max-width: 767px) {
  .solo-video__btn {
    opacity: 1;
  }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function buildEmbedUrl(videoId, provider) {
    if (provider === 'youtube' && videoId) {
      return 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&mute=1&controls=0&modestbranding=1&rel=0&loop=1&playlist=' + videoId + '&enablejsapi=1&background=1&showinfo=0&iv_load_policy=3&fs=0&disablekb=1&cc_load_policy=0';
    }
    if (provider === 'vimeo' && videoId) {
      return 'https://player.vimeo.com/video/' + videoId + '?autoplay=1&muted=1&loop=1&controls=0&title=0&byline=0&portrait=0&dnt=1';
    }
    return null;
  }

  function pmYT(iframe, func, args) {
    iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: func, args: args || [] }), '*');
  }

  function pmVimeo(iframe, method, value) {
    var msg = { method: method };
    if (value !== undefined) msg.value = value;
    iframe.contentWindow.postMessage(JSON.stringify(msg), '*');
  }

  function setPlayState(btn, playing) {
    btn.setAttribute('aria-pressed', playing ? 'true' : 'false');
    btn.setAttribute('aria-label', playing ? 'Pause video' : 'Play video');
  }

  function setSoundState(btn, soundOn) {
    btn.setAttribute('aria-pressed', soundOn ? 'true' : 'false');
    btn.setAttribute('aria-label', soundOn ? 'Mute video' : 'Unmute video');
  }

  function setupFullscreen(btn, el) {
    btn.addEventListener('click', function () {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else if (el.requestFullscreen) {
        el.requestFullscreen();
      }
    });
    document.addEventListener('fullscreenchange', function () {
      var isFs = document.fullscreenElement === el;
      btn.setAttribute('aria-pressed', isFs ? 'true' : 'false');
      btn.setAttribute('aria-label', isFs ? 'Exit fullscreen' : 'Enter fullscreen');
    });
  }

  function initExternalPlayer(player) {
    var embedUrl = buildEmbedUrl(player.dataset.videoUrl, player.dataset.videoProvider);
    if (!embedUrl) return;

    var provider = player.dataset.videoProvider;
    var iframe = document.createElement('iframe');
    iframe.src = embedUrl;
    iframe.allow = 'autoplay; fullscreen; picture-in-picture';
    iframe.setAttribute('allowfullscreen', '');

    var iframeWrap = player.querySelector('.solo-video__iframe-wrap');
    var thumbWrap = player.querySelector('.solo-video__thumbnail-wrap');

    iframeWrap.appendChild(iframe);
    iframeWrap.removeAttribute('hidden');
    if (thumbWrap) thumbWrap.style.visibility = 'hidden';

    var overlay = document.createElement('div');
    overlay.className = 'solo-video__iframe-overlay';
    player.appendChild(overlay);

    var PP_PLAYING = '<span class="sv-icon-playing"><svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg></span>';
    var PP_PAUSED  = '<span class="sv-icon-paused"><svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg></span>';
    var SND_MUTED  = '<span class="sv-icon-muted"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg></span>';
    var SND_ON     = '<span class="sv-icon-sound"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg></span>';
    var FS_EXPAND  = '<span class="sv-icon-expand"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg></span>';
    var FS_COMPRESS= '<span class="sv-icon-compress"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true"><path d="M8 3v3a2 2 0 0 1-2 2H3"/><path d="M21 8h-3a2 2 0 0 1-2-2V3"/><path d="M3 16h3a2 2 0 0 1 2 2v3"/><path d="M16 21v-3a2 2 0 0 1 2-2h3"/></svg></span>';

    var ppBtn = document.createElement('button');
    ppBtn.className = 'solo-video__btn solo-video__btn--playpause';
    ppBtn.type = 'button';
    ppBtn.setAttribute('aria-pressed', 'true');
    ppBtn.setAttribute('aria-label', 'Pause video');
    ppBtn.innerHTML = PP_PLAYING + PP_PAUSED;
    player.appendChild(ppBtn);

    ppBtn.addEventListener('click', function () {
      var playing = ppBtn.getAttribute('aria-pressed') === 'true';
      if (provider === 'youtube') {
        pmYT(iframe, playing ? 'pauseVideo' : 'playVideo');
      } else {
        pmVimeo(iframe, playing ? 'pause' : 'play');
      }
      setPlayState(ppBtn, !playing);
    });

    var sndBtn = document.createElement('button');
    sndBtn.className = 'solo-video__btn solo-video__btn--sound';
    sndBtn.type = 'button';
    sndBtn.setAttribute('aria-pressed', 'false');
    sndBtn.setAttribute('aria-label', 'Unmute video');
    sndBtn.innerHTML = SND_MUTED + SND_ON;
    player.appendChild(sndBtn);

    sndBtn.addEventListener('click', function () {
      var soundOn = sndBtn.getAttribute('aria-pressed') === 'true';
      if (provider === 'youtube') {
        pmYT(iframe, soundOn ? 'mute' : 'unMute');
        if (!soundOn) pmYT(iframe, 'setVolume', [100]);
      } else {
        pmVimeo(iframe, 'setVolume', soundOn ? 0 : 1);
      }
      setSoundState(sndBtn, !soundOn);
    });

    var fsBtn = document.createElement('button');
    fsBtn.className = 'solo-video__btn solo-video__btn--fullscreen';
    fsBtn.type = 'button';
    fsBtn.setAttribute('aria-pressed', 'false');
    fsBtn.setAttribute('aria-label', 'Enter fullscreen');
    fsBtn.innerHTML = FS_EXPAND + FS_COMPRESS;
    player.appendChild(fsBtn);
    setupFullscreen(fsBtn, player.closest('.solo-video__wrap'));
  }

  function initHostedPlayer(player) {
    var video = player.querySelector('video');
    var ppBtn = player.querySelector('.solo-video__btn--playpause');
    var sndBtn = player.querySelector('.solo-video__btn--sound');
    var fsBtn = player.querySelector('.solo-video__btn--fullscreen');

    if (video && ppBtn) {
      ppBtn.addEventListener('click', function () {
        if (video.paused) { video.play(); } else { video.pause(); }
      });
      video.addEventListener('play', function () { setPlayState(ppBtn, true); });
      video.addEventListener('pause', function () { setPlayState(ppBtn, false); });
    }

    if (video && sndBtn) {
      sndBtn.addEventListener('click', function () {
        if (video.muted) { video.volume = 1; video.muted = false; }
        else { video.muted = true; }
        setSoundState(sndBtn, !video.muted);
      });
    }

    if (video && fsBtn) {
      setupFullscreen(fsBtn, player.closest('.solo-video__wrap'));
    }
  }

  function init() {
    document.querySelectorAll('.solo-video__player--external').forEach(initExternalPlayer);
    document.querySelectorAll('.solo-video__player--hosted').forEach(initHostedPlayer);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
{% endjavascript %}

{% schema %}
{
  "name": "Solo Video",
  "tag": "section",
  "class": "section-solo-video",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "light", "label": "Light" }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube / Vimeo URL",
      "accept": ["youtube", "vimeo"],
      "placeholder": "https://www.youtube.com/watch?v=..."
    },
    {
      "type": "image_picker",
      "id": "thumbnail",
      "label": "Thumbnail image",
      "info": "Shown before a YouTube or Vimeo video loads"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "info": "Only applies when Full width is disabled",
      "min": 600,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Solo Video"
    }
  ]
}
{% endschema %}
