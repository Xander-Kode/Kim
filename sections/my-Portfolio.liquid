{{ 'my-Portfolio.css' | asset_url | stylesheet_tag }}
<script src="{{ 'my-Portfolio.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #MyPortfolio-{{ section.id }} {
    --mp-bg: {{ section.settings.background }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<my-portfolio
  id="MyPortfolio-{{ section.id }}"
  class="mp-section"
  data-speed="{{ section.settings.speed }}"
>
  {%- if section.settings.show_fades -%}
    <div class="mp-fade mp-fade--left"></div>
    <div class="mp-fade mp-fade--right"></div>
  {%- endif -%}

  {%- if section.settings.heading != blank or section.settings.text != blank -%}
    <div class="mp-intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="mp-intro__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="mp-intro__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="mp-track">
    <div class="mp-inner">
      {%- comment -%} The second copy makes the loop seamless; it is hidden from assistive tech. {%- endcomment -%}
      {%- for copy in (1..2) -%}
        <div class="mp-block"{% if copy == 2 %} aria-hidden="true" inert{% endif %}>
          {%- for block in section.blocks -%}
            {%- liquid
              if copy == 1
                assign attrs = block.shopify_attributes
              else
                assign attrs = ''
              endif
            -%}
            {%- case block.type -%}
              {%- when 'social' -%}
                {%- render 'mp-card',
                  variant: 'social',
                  image: block.settings.image,
                  title: block.settings.title,
                  text: block.settings.text,
                  badge: block.settings.badge,
                  link: block.settings.link,
                  attrs: attrs
                -%}
              {%- when 'pair' -%}
                <div class="mp-pair" {{ attrs }}>
                  {%- render 'mp-card',
                    variant: 'cinematic',
                    image: block.settings.image_1,
                    title: block.settings.title_1,
                    badge: block.settings.badge_1,
                    link: block.settings.link_1
                  -%}
                  {%- render 'mp-card',
                    variant: 'cinematic',
                    image: block.settings.image_2,
                    title: block.settings.title_2,
                    badge: block.settings.badge_2,
                    link: block.settings.link_2
                  -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</my-portfolio>

{% schema %}
{
  "name": "My Portfolio",
  "tag": "section",
  "class": "section-my-portfolio",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Portfolio"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Discover a new perspective through films from visionary creators."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#09090b"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Auto-scroll speed",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80,
      "info": "Pixels per second. Set to 0 to turn off auto-scroll."
    },
    {
      "type": "checkbox",
      "id": "show_fades",
      "label": "Fade edges",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Tall card (9:16)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Project title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "A short description of this project."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "9:16"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "pair",
      "name": "Stacked pair",
      "settings": [
        {
          "type": "header",
          "content": "Top card"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title_1",
          "label": "Title",
          "default": "Project title"
        },
        {
          "type": "text",
          "id": "badge_1",
          "label": "Badge",
          "default": "21:9"
        },
        {
          "type": "url",
          "id": "link_1",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Bottom card"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title_2",
          "label": "Title",
          "default": "Project title"
        },
        {
          "type": "text",
          "id": "badge_2",
          "label": "Badge",
          "default": "16:9"
        },
        {
          "type": "url",
          "id": "link_2",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "My Portfolio",
      "blocks": [
        {
          "type": "social",
          "settings": {
            "title": "Urban Exploration",
            "text": "A journey through the concrete jungle at twilight."
          }
        },
        {
          "type": "pair",
          "settings": {
            "title_1": "Abstract Dimensions",
            "title_2": "Nature's Echo"
          }
        },
        {
          "type": "social",
          "settings": {
            "title": "Neon Drift",
            "text": "Midnight aesthetics and fast cars."
          }
        },
        {
          "type": "pair",
          "settings": {
            "title_1": "Portraits of Light",
            "badge_1": "16:9",
            "title_2": "Macro Worlds",
            "badge_2": "21:9"
          }
        },
        {
          "type": "social",
          "settings": {
            "title": "Analog Textures",
            "text": "Grain, light leaks, and nostalgia."
          }
        }
      ]
    }
  ]
}
{% endschema %}
